{
    "name": "Python Parallel Programming",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "userEnvProbe": "none",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "remoteUser": "vscode",
    "runArgs": [
        "--volume=/tmp/.X11-unix:/tmp/.X11-unix:ro"
    ],
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}"
    }
}